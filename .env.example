# Runtime environment: 'development', 'production', or 'test'
NODE_ENV=development

# HTTP server port (default: 3000)
PORT=3000

# MongoDB Atlas or local connection URI (in development, falls back to in-memory server if omitted)
MONGODB_URI=mongodb://localhost:27017/velora

# Secret key for signing and verifying JWT tokens (use a random string >= 32 chars in production)
JWT_SECRET=super-secret-velora-jwt-token-key-change-in-production

# Allowed client origin for CORS allowlist (e.g., https://your-velora-app.vercel.app, comma-separated if multiple)
CLIENT_URL=http://localhost:5173

# Frontend API base URL (empty string = same-origin / relative /api calls)
VITE_API_URL=

# Controls visibility of one-click test credentials for Customer, Staff, and Admin (true | false)
VITE_DEMO_MODE=true

# Payment gateway secret (currently simulated sandbox for portfolio demonstration)
PAYMENT_SECRET=simulated_payment_secret_key_demo

# SMTP email host (currently simulated if omitted or incomplete)
EMAIL_HOST=smtp.mailtrap.io

# SMTP email port (typically 587 or 465)
EMAIL_PORT=587

# SMTP email username / authentication identity
EMAIL_USER=velora-service

# SMTP email password / application secret
EMAIL_PASS=velora-password-secret

# Sender email address for order receipts and booking confirmations
EMAIL_FROM=concierge@velora-dining.com
